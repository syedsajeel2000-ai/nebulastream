# ─────────────────────────────────────────────────────────────
# NebulaStream environment configuration
# Copy to .env.local and adjust. NEVER commit your real .env files.
# ─────────────────────────────────────────────────────────────

# Secret used to sign session tokens (HMAC). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a dev fallback is used — ALWAYS set this in production.
SESSION_SECRET=

# Where the SQLite database file lives (default: ./data/nebula.db; /tmp/nebula-data on Vercel)
# NEBULA_DATA_DIR=./data

# Turso cloud database (optional — enables persistent data on serverless hosts like Vercel).
# When both are set, the local SQLite file becomes an embedded replica of the Turso DB:
# reads stay local, writes replicate to Turso. Easiest setup: install the Turso
# integration on Vercel (`vercel install turso/database`) — it sets both for you.
# TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
# TURSO_AUTH_TOKEN=your-token

# Force cookies to work without HTTPS (local production tests only!)
# NEBULA_INSECURE_COOKIES=1
